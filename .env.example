# Obligatorio (una o varias claves separadas por coma). Cabecera: x-api-key o Authorization: Bearer
API_KEYS=cambia-esta-clave
PORT=3000

# LLM de respaldo (opcional). Sin esta clave solo se usa OCR.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
LLM_TIMEOUT_MS=60000
LLM_MIN_SCORE=2

# Rendimiento
OCR_WORKERS=2
MAX_QUEUE=50
MAX_MB=10
